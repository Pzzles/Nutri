# Copy to `supabase/.env` for local Edge Functions. Never commit real values.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meal parsing provider. Leave GROQ_API_URL empty in production to use Groq's
# official OpenAI-compatible endpoint.
GROQ_API_KEY=
GROQ_API_URL=

FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# Optional; the application falls back to USDA's rate-limited DEMO_KEY.
USDA_FDC_API_KEY=

CRON_SECRET=
