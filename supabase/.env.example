# Copy this to `.env` (for local `supabase functions serve`) and set the
# same values as secrets in your deployed Supabase project:
#   supabase secrets set --env-file supabase/.env

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key — used by parse-meal only. Never exposed to the client.
ANTHROPIC_API_KEY=

# FatSecret Platform API — primary food data source.
# OAuth 1.0 Consumer Key/Secret (no IP restrictions, unlike OAuth 2.0).
# Get these from platform.fatsecret.com → Dashboard → API Keys.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# Shared secret for the scheduled recalculate-frequency-rankings function.
# Generate something random; set it as the x-cron-secret header on your
# pg_cron / scheduled trigger call.
CRON_SECRET=
