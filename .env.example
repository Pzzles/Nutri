# Root .env.example — for reference only.
# Actual secrets live in:
#   web/.env.local          (Vite — never committed)
#   supabase/.env           (Edge Functions + local dev — never committed)
#
# Copy the relevant file for your context:
#   cp web/.env.example     web/.env.local
#   cp supabase/.env.example supabase/.env

# ── Supabase ────────────────────────────────────────────────────────────────
# Find these in the Supabase dashboard → Project Settings → API.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Claude (Anthropic) ─────────────────────────────────────────────────────
# Used by the parse-meal edge function only. Never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# ── FatSecret ─────────────────────────────────────────────────────────────
# OAuth 1.0 credentials — get from platform.fatsecret.com → Dashboard.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# ── Cron ──────────────────────────────────────────────────────────────────
# Shared secret for the recalculate-frequency-rankings scheduled function.
CRON_SECRET=
